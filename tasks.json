{
  "tasks": {
    "build": {
      "label": "Build the project",
      "type": "shell",
      "command": "dotnet build --configuration Release"
    },
    "test": {
      "label": "Run tests",
      "type": "shell",
      "command": "dotnet test",
      "dependsOn": ["build"],
      "allowConcurrent": true
    },
    "clean": {
      "label": "Clean build artifacts",
      "type": "shell",
      "command": "dotnet clean"
    },
    "restore": {
      "label": "Restore packages",
      "type": "shell",
      "command": "dotnet restore"
    },
    "hello": {
      "label": "Hello World Example",
      "type": "shell",
      "command": "echo",
      "args": ["Hello from dotnet-runner!"]
    },
    "echo-env": {
      "label": "Example with environment variables",
      "type": "shell",
      "command": "echo $MY_VAR",
      "env": {
        "MY_VAR": "custom value"
      }
    },
    "custom-dir": {
      "label": "Example with custom working directory",
      "type": "shell",
      "command": "pwd",
      "cwd": "/tmp"
    },
    "silent-task": {
      "label": "Task with no output echoing",
      "type": "shell",
      "command": "echo This will not be shown",
      "echo": false
    },
    "process-example": {
      "label": "Process type example",
      "type": "process",
      "command": "dotnet",
      "args": ["--version"]
    },
    "parallel-example": {
      "label": "Example of parallel task",
      "type": "shell",
      "command": "echo This task can run dependencies in parallel",
      "dependsOn": ["build", "restore"],
      "allowConcurrent": true
    }
  }
}